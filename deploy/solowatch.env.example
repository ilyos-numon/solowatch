# /etc/solowatch/solowatch.env (권한 640, root:solowatch). 비밀 값은 이 파일에만 둔다. 커밋 금지.
# Supabase 프로젝트 URL 과 anon 키 (가족 앱과 같은 프로젝트)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Supabase 에 만든 기기 전용 사용자 (households 의 device 멤버)
SOLOWATCH_DEVICE_EMAIL=device@example.com
SOLOWATCH_DEVICE_PASSWORD=
# 선택: Apprise URL, 쉼표 구분. 비우면 앱 알림만 쓴다. 예: tgram://BOT_TOKEN/CHAT_ID
SOLOWATCH_APPRISE_URLS=
