# 로컬 개발용. 값은 `supabase status -o env` 에서 복사한다. 실제 .env 는 커밋하지 않는다.
SUPABASE_URL=http://localhost:57321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SOLOWATCH_DEVICE_EMAIL=device@example.com
SOLOWATCH_DEVICE_PASSWORD=solowatch-demo-1234
SOLOWATCH_APPRISE_URLS=
E2E_SUPABASE_URL=http://localhost:57321
E2E_SERVICE_ROLE_KEY=

# 웹 푸시 (VAPID 공개키, 데모)
VAPID_PUBLIC_KEY=
